# Example sweep plan for scripts/fx-sweep.sh
# name | fx settings (key=value ...) | settle seconds | caption
off        | 100=0                | 2 | BLUR OFF
s100       | 100=1 101=100        | 2 | STRENGTH 100
s200       | 101=200              | 2 | STRENGTH 200
s300       | 101=300              | 2 | STRENGTH 300
sub4       | 101=220 142=4        | 2 | SUB-STEPS 4
